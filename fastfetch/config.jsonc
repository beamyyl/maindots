{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "padding": {
      "top": 2
    }
  },

  "display": {
    "separator": "",
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "-"
      },
      "border": {
        "left": "|",
        "right": "|"
      },
      "width": 14,
      "color": {
        "elapsed": "white",
        "total": "white",
        "border": "white"
      }
    },
    "percent": {
      "type": 6
    }
  },

  "modules": [
    {
      "type": "custom",
      "key": "{#90}╭ Keys ───────",
      "format": "{#90}│ Values ───────────────────────╮"
    },

    {
      "type": "title",
      "key": "{#90}│ {#96} User      {#90}",
      "format": "  {user-name} {#2}[{home-dir}]"
    },

    {
      "type": "cpu",
      "key": "{#90}│ {#96} CPU       {#90}",
      "showPeCoreCount": true,
      "format": "  {name} {#2}[{core-types}] [{freq-max}]"
    },

    {
      "type": "gpu",
      "key": "{#90}│ {#96}󰍛 GPU       {#90}",
      "format": "  {vendor} {name} {#2}[{type}]"
    },

    {
      "type": "disk",
      "key": "{#90}│ {#96} Disk      {#90}",
      "folders": "/",
      "format": "  {size-percentage-bar} {size-used} / {size-total}"
    },

    {
      "type": "memory",
      "key": "{#90}│ {#96}󰍛 Memory    {#90}",
      "format": "  {percentage-bar} {used} / {total}"
    },

    {
      "type": "os",
      "key": "{#90}│ {#95} OS        {#90}",
      "format": "  {pretty-name} {#2}[{arch}]"
    },

    {
      "type": "kernel",
      "key": "{#90}│ {#95} Kernel    {#90}",
      "format": "  {sysname} {#2}[v{release}]"
    },

    {
      "type": "packages",
      "key": "{#90}│ {#95}󰏖 Packages    {#90}"
    },

    {
      "type": "initsystem",
      "key": "{#90}│ {#95} Init      {#90}",
      "format": "  {name} {#2}[{version}]"
    },

    {
      "type": "shell",
      "key": "{#90}│ {#95} Shell     {#90}",
      "format": "  {pretty-name} {#2}[v{version}]"
    },

    {
      "type": "uptime",
      "key": "{#90}│ {#94}󰅐 Uptime    {#90}",
      "format": "  {?days}{days} Days + {?}{hours} hour, {minutes} mins"
    },

    {
      "type": "de",
      "key": "{#90}│ {#94} Desktop   {#90}",
      "format": "  {pretty-name} {#2}[v{version}]"
    },

    {
      "type": "wm",
      "key": "{#90}│ {#94} WM        {#90}",
      "format": "  {pretty-name} {#2}[{protocol-name}]"
    },

    {
      "type": "command",
      "key": "{#90}│ {#94}󰌽 OS Age    {#90}",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days",
      "format": "  {result}"
    },

    {
      "type": "terminal",
      "key": "{#90}│ {#94} Terminal  {#90}",
      "format": "  {pretty-name} {#2}[{version}]"
    },

    {
      "type": "custom",
      "key": "{#90}╰─────────────",
      "format": "{#90}│──────────────────────────────╯"
    },

    {
      "type": "custom",
      "key": " ",
      "format": "{#90}╭ Colors ──────────────────────────╮"
    },

    {
      "type": "custom",
      "format": "{#90}│ {#40}    {#41}    {#42}    {#43}    {#44}    {#45}    {#46}    {#47}    {#}{#90} │"
    },

    {
      "type": "custom",
      "format": "{#90}│ {#100}    {#101}    {#102}    {#103}    {#104}    {#105}    {#106}    {#107}    {#}{#90} │"
    },

    {
      "type": "custom",
      "format": "{#90}╰──────────────────────────────────╯"
    }
  ]
}
